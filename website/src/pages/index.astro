---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/home.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}${path}`;
const repo = 'https://github.com/lenilsonjr/means';
const features = [
  [
    '01',
    'One file. Your books.',
    'Your ledger lives in a local SQLite file. Use the terminal UI for daily review and the CLI for imports, reports, and scripts.',
    '/docs/getting-started/',
    'Set up means',
  ],
  [
    '02',
    'From statement to posting.',
    'Split a purchase across categories and keep the original bank line attached. Later, open the entry to check how it was booked.',
    '/docs/guides/import-formats/',
    'Understand imports',
  ],
  [
    '03',
    'Different currencies. Balanced books.',
    'Keep a bank account in euros and your personal books in dollars. Each posting stores its native quantity and accounting-currency value.',
    '/docs/concepts/',
    'Explore the model',
  ],
  [
    '04',
    'A vault for each entity.',
    'Keep personal and company books in separate vaults, each with its own chart of accounts and currency. Switch vaults to review their balances.',
    '/docs/concepts/#vaults-and-entities',
    'Organize your accounts',
  ],
  [
    '05',
    'Bring the banks with you.',
    'Connect a bank or import a statement. Rules handle familiar transactions; Review collects drafts and posted entries awaiting your attention.',
    '/docs/guides/connections/',
    'Connect a bank',
  ],
  [
    '06',
    'Useful beyond the terminal.',
    'Send your accountant a signed, encrypted read-only vault, or export booked values to Beancount for use with Fava.',
    '/docs/guides/vault-sharing-usage/',
    'Share your books',
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0d0f" />
    <title>means — Your money. Your books. Your machine.</title>
    <meta
      name="description"
      content="Local double-entry accounting across entities and currencies. Import bank statements, review postings, and keep your books in a SQLite file. Built in Rust."
    />
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />
    <meta property="og:title" content="means — Your money. Your books. Your machine." />
    <meta property="og:description" content="Double-entry accounting, at home in your terminal." />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <nav class="nav wrap" aria-label="Main navigation">
        <a class="brand" href={link('/')} aria-label="means home">
          <img src={link('/favicon.svg')} alt="" width="28" height="28" />
          means<span class="nav-badge">early development</span>
        </a>
        <div class="nav-links">
          <a href={link('/docs/introduction/')}>Documentation</a>
          <a class="source-link" href={repo}>
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <a class="eyebrow" href={link('/docs/concepts/')}>
          <span class="status-dot"></span> LOCAL BOOKS. CLEAR EVIDENCE.{' '}
          <span aria-hidden="true">→</span>
        </a>
        <h1 id="hero-title">
          Your money.
          <br />
          Your books. <span>Your machine.</span>
        </h1>
        <p class="hero-description">
          Local double-entry accounting in your terminal.
          <br class="desktop-break" /> Review transactions, reconcile accounts, and keep the
          evidence.
          <br class="desktop-break" /> For personal and company books, across currencies.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={link('/docs/getting-started/')}>
            Start your ledger <span aria-hidden="true">↗</span>
          </a>
          <a class="button secondary" href={link('/docs/introduction/')}>
            Read the docs <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="install-line">
          <span aria-hidden="true">$</span>
          <code>cargo install --path crates/means-server --locked</code>
          <button
            id="copy-install"
            type="button"
            aria-label="Copy install command"
            title="Run from a clone of the repository"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="8" y="8" width="12" height="13" rx="2" />
              <path d="M16 8V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4" />
            </svg>
          </button>
        </div>
        <p class="install-note" id="copy-status" role="status">
          From a repository clone · Rust + protoc required
        </p>
      </section>
      <section class="product wrap" aria-label="Actual means terminal screenshot">
        <a
          class="terminal screenshot-link"
          href={link('/media/overview.png')}
          aria-label="Open the full-size TUI screenshot"
        >
          <img
            src={link('/media/overview.png')}
            width="1248"
            height="714"
            alt="The real means TUI showing a synthetic Personal vault, net worth, assets, liabilities, and recent entries."
            fetchpriority="high"
          />
        </a>
        <p class="preview-caption">
          The actual TUI. Fictional books. <a href="#watch">Watch it work ↓</a>
        </p>
      </section>
      <div class="foundation wrap" aria-label="Project foundations">
        <span>BUILT WITH OPEN-SOURCE TOOLS</span>
        <div>
          <strong>Rust</strong>
          <span>+</span>
          <strong>SQLite</strong>
          <span>+</span>
          <strong>Double-entry</strong>
          <span>+</span>
          <strong>Your terminal</strong>
        </div>
      </div>
      <section class="recordings wrap" id="watch" aria-labelledby="recordings-title">
        <div class="section-heading">
          <span class="mono-label">TERMINAL SESSIONS</span>
          <h2 id="recordings-title">Welcome to your machine.</h2>
          <p>
            Real keystrokes. Real postings. Entirely fictional books.
            <br />A little amber light, and a clear view of the numbers.
          </p>
        </div>
        <article class="recording">
          <div class="recording-copy">
            <span class="feature-number">01 / THE TOUR</span>
            <h3>Follow the books.</h3>
            <p>
              Open an account. Change the order. Inspect a posting. Read expense reports and switch
              between personal and company vaults.
            </p>
          </div>
          <div class="demo-player">
            <video
              muted
              loop
              playsinline
              preload="auto"
              poster={link('/media/account-ledger.png')}
              width="1248"
              height="714"
              aria-label="Actual TUI recording: accounts, sorting, reports, and vaults"
            >
              <source src={link('/media/overview.mp4')} type="video/mp4" />
              <track
                kind="captions"
                src={link('/media/overview.vtt')}
                srclang="en"
                label="English workflow captions"
              />
            </video>
            <button class="demo-play" type="button" hidden>
              Play demo
            </button>
          </div>
        </article>
        <article class="recording">
          <div class="recording-copy">
            <span class="feature-number">02 / THE SPLIT</span>
            <h3>Every part in its place.</h3>
            <p>
              Turn one $90.50 bank line into groceries and household expenses. Preview every
              posting, then confirm. The original evidence stays linked.
            </p>
          </div>
          <div class="demo-player">
            <video
              muted
              loop
              playsinline
              preload="auto"
              poster={link('/media/review-split.png')}
              width="1248"
              height="714"
              aria-label="Actual TUI recording: split an imported draft and confirm its postings"
            >
              <source src={link('/media/review-split.mp4')} type="video/mp4" />
              <track
                kind="captions"
                src={link('/media/review-split.vtt')}
                srclang="en"
                label="English workflow captions"
              />
            </video>
            <button class="demo-play" type="button" hidden>
              Play demo
            </button>
          </div>
        </article>
        <div class="screenshot-grid">
          <figure>
            <a href={link('/media/confirmation.png')}>
              <img
                src={link('/media/confirmation.png')}
                width="1248"
                height="714"
                loading="lazy"
                alt="Actual confirmation modal: 90.50 credited from Current, 72.40 debited to Groceries and 18.10 to Household."
              />
            </a>
            <figcaption>See the whole entry before you confirm.</figcaption>
          </figure>
          <figure>
            <a href={link('/media/expense-report.png')}>
              <img
                src={link('/media/expense-report.png')}
                width="1248"
                height="714"
                loading="lazy"
                alt="Actual means expense report for the fictional personal vault, grouped by expense class."
              />
            </a>
            <figcaption>Read the result in your reports.</figcaption>
          </figure>
        </div>
      </section>
      <section class="features wrap" aria-labelledby="features-title">
        <div class="section-heading">
          <span class="mono-label">THE ACCOUNTING COMES FIRST</span>
          <h2 id="features-title">
            A clear picture.
            <br />
            <span>A trail you can follow.</span>
          </h2>
          <p>
            Balanced entries, native amounts, and linked statements.
            <br />
            Check a balance, then follow it back to the transactions behind it.
          </p>
        </div>
        <div class="feature-grid">
          {features.map(([number, title, description, href, label]) => (
            <article class="feature">
              <span class="feature-number">{number} /</span>
              <h3>{title}</h3>
              <p>{description}</p>
              <a href={link(href)}>
                {label}
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>
      <section class="connections wrap" aria-labelledby="connections-title">
        <div>
          <span class="mono-label">YOUR DATA HAS A WAY IN</span>
          <h2 id="connections-title">Start with what you have.</h2>
          <p>
            Import a statement. Connect a bank. Bring an Account Tracker backup.
            <br />
            Choose an account and a booking cutoff, then review the imported transactions.
          </p>
          <a class="text-link" href={link('/docs/guides/connections/')}>
            Find your import route <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="provider-list" aria-label="Supported data sources">
          <span>Pluggy</span>
          <span>Enable Banking</span>
          <span>Mercury</span>
          <span>Wise business</span>
          <span>Banco Inter PJ</span>
          <span>CSV / OFX</span>
          <span>Account Tracker</span>
          <span>IMAP attachments</span>
        </div>
      </section>
      <section class="closing wrap">
        <div class="closing-mark" aria-hidden="true">
          m<span>_</span>
        </div>
        <h2>
          Make yourself at home
          <br />
          in your books.
        </h2>
        <p>Create a vault, import a statement, and review your first entries.</p>
        <a class="button primary" href={link('/docs/getting-started/')}>
          Get started <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>
    <footer class="site-footer wrap">
      <a class="brand" href={link('/')}>
        <img src={link('/favicon.svg')} alt="" width="23" height="23" />
        means
      </a>
      <p>Local books. Apache-2.0.</p>
      <div>
        <a href={link('/docs/contributing/')}>Contribute</a>
        <a href={repo}>
          Source <span aria-hidden="true">↗</span>
        </a>
        <a href={link('/third-party-notices.txt')}>Notices</a>
      </div>
    </footer>
    <script>
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const players = [...document.querySelectorAll<HTMLElement>('.demo-player')].map((element) => {
        const video = element.querySelector<HTMLVideoElement>('video')!;
        const button = element.querySelector<HTMLButtonElement>('button')!;
        let requested = false;
        let visible = false;
        const showAction = () => {
          button.hidden = !video.paused && !motion.matches;
          button.textContent = video.paused ? 'Play demo' : 'Pause demo';
        };
        const sync = () => {
          video.muted = true;
          video.autoplay = !motion.matches;
          if (document.hidden || !visible || (motion.matches && !requested)) {
            video.pause();
            showAction();
            return;
          }
          void video.play().then(showAction).catch(showAction);
        };
        button.addEventListener('click', () => {
          if (!video.paused) {
            requested = false;
            video.pause();
          } else {
            requested = true;
            // Keep play() inside the gesture for browsers that block autoplay.
            void video.play().then(showAction).catch(showAction);
          }
        });
        video.addEventListener('playing', showAction);
        video.addEventListener('pause', showAction);
        const observer = new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          sync();
        });
        observer.observe(video);
        showAction();
        return {
          sync,
          reset: () => {
            requested = false;
            sync();
          },
        };
      });
      motion.addEventListener('change', () => players.forEach((player) => player.reset()));
      document.addEventListener('visibilitychange', () =>
        players.forEach((player) => player.sync()),
      );

      document.querySelector('#copy-install')?.addEventListener('click', async () => {
        const status = document.querySelector('#copy-status');
        try {
          await navigator.clipboard.writeText('cargo install --path crates/means-server --locked');
          if (status) status.textContent = 'Copied. Run from your means repository clone.';
        } catch {
          if (status) status.textContent = 'Select and copy the command above.';
        }
      });
    </script>
  </body>
</html>
