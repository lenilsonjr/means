{
  "name": "means-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:docs": "node scripts/prepare-docs.mjs",
    "dev": "npm run prepare:docs && astro dev --host 127.0.0.1",
    "build": "npm run prepare:docs && astro build && node scripts/check-links.mjs",
    "check": "npm run prepare:docs && astro check",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@xterm/xterm": "^6.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0"
}
